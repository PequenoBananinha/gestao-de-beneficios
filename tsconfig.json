{
  "compilerOptions": {
    // Estrutura de pastas
    "rootDir": "./src",
    "outDir": "./dist",

    // Ambiente
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "esModuleInterop": true,

    // Saídas
    "sourceMap": true,

    // Rigor
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}